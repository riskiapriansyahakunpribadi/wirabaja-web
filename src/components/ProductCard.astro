---
import type { ProductUnit } from '@/data/products';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  product: ProductUnit;
}

const { product } = Astro.props;

// String pencarian gabungan agar filter teks bekerja pada nama, kategori, kelas, dan spesifikasi kunci.
const searchableText = [
  product.name,
  product.categoryLabel,
  product.unitClass,
  product.status,
  product.shortDescription,
  ...product.keySpecs.map((spec) => `${spec.label} ${spec.value}`),
]
  .join(' ')
  .toLowerCase();

const isNew = product.status === 'Baru';
---

<article
  data-product-card
  data-category={product.category}
  data-status={product.status.toLowerCase()}
  data-search={searchableText}
  class="card-product catalog-card h-full"
>
  <a
    href={`/produk/${product.slug}`}
    class="card-product-media cut-corner-tr block aspect-[16/10]"
    aria-label={`Lihat detail spesifikasi ${product.name}`}
  >
    <img
      src={product.image}
      alt={product.imageAlt}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <span
      class:list={[
        'absolute top-3 left-3 px-3 py-1 font-display text-xs font-bold uppercase tracking-wider shadow-sm',
        isNew ? 'bg-safety text-steel-950' : 'bg-steel-950 text-white border border-white/25',
      ]}
    >
      {product.status}
    </span>
    <span class="absolute right-3 bottom-3 bg-steel-950/90 px-2.5 py-1 text-xs font-semibold text-white">
      {product.options.join(' / ')}
    </span>
  </a>

  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold uppercase tracking-wider text-steel-gray">
        <span>{product.categoryLabel}</span>
        <span class="text-steel-950">{product.unitClass}</span>
      </div>

      <h3 class="mt-2 text-2xl text-steel-950">
        <a
          href={`/produk/${product.slug}`}
          class="text-steel-950 no-underline transition-colors hover:text-safety-dark"
        >
          {product.name}
        </a>
      </h3>
      <span class="card-product-title-line" aria-hidden="true"></span>

      <p class="mt-3 text-sm leading-relaxed text-steel-gray">
        {product.shortDescription}
      </p>

      <!-- Tiga spesifikasi kunci untuk pembandingan cepat antar unit -->
      <dl class="m-0 mt-4 grid grid-cols-3 gap-2 border-t border-b border-border-light py-3">
        {product.keySpecs.map((spec) => (
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-wide text-steel-gray">
              {spec.label}
            </dt>
            <dd class="m-0 mt-0.5 font-display text-base font-bold text-steel-950">
              {spec.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-5 space-y-3">
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-steel-gray">
          Harga Unit
        </span>
        <span class="font-display text-base font-bold uppercase tracking-wide text-steel-950">
          {product.priceNote}
        </span>
      </div>

      <div class="card-product-action flex flex-col gap-2">
        <Button
          href={`/produk/${product.slug}#form-penawaran`}
          variant="primary"
          size="sm"
          icon="arrow-right"
          class="w-full justify-between"
        >
          Minta Penawaran Unit Ini
        </Button>

        <a
          href={`/produk/${product.slug}`}
          class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-[4px] border border-border-light bg-surface-warm px-4 font-display text-sm font-bold uppercase tracking-wide text-steel-950 transition-colors hover:border-steel-950 hover:bg-surface-tint"
        >
          <span>Lihat Spesifikasi Lengkap</span>
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</article>