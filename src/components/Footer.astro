---
import { siteConfig, getCopyrightYear, buildWhatsAppUrl } from '@/config/site';
import BrandLogo from './BrandLogo.astro';
import Icon, { type IconName } from './Icon.astro';

const currentYear = getCopyrightYear();
const whatsappUrl = buildWhatsAppUrl();

const socialIconMap: Record<'LinkedIn' | 'Instagram' | 'YouTube', IconName> = {
  LinkedIn: 'linkedin',
  Instagram: 'instagram',
  YouTube: 'youtube',
};

const serviceLinks = [
  { label: 'Penjualan Unit Baru dan Bekas', href: '/layanan#penjualan' },
  { label: 'Penyewaan Alat Berat Proyek', href: '/layanan#penyewaan' },
  { label: 'Servis dan Perawatan Berkala', href: '/layanan#servis' },
  { label: 'Pasokan Suku Cadang', href: '/layanan#suku-cadang' },
  { label: 'Dukungan Pembiayaan Unit', href: '/layanan#pembiayaan' },
];
---

<footer
  transition:name="site-footer"
  transition:animate="none"
  class="border-t-4 border-safety bg-steel-950 text-white"
>
  <div class="container-wide py-14 lg:py-16">
    <!-- Tata letak asimetris 3 kolom: identitas utama, tautan layanan dan halaman, serta alamat operasional -->
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1.15fr] lg:gap-12">
      <div class="space-y-5">
        <a
          href="/"
          class="logo-link"
          aria-label={`${siteConfig.legalName}, kembali ke Beranda`}
        >
          <BrandLogo variant="dark" />
        </a>

        <p class="max-w-md text-sm leading-relaxed text-steel-muted">
          {siteConfig.legalName} melayani {siteConfig.businessField.toLowerCase()} bagi kontraktor, pengelola tambang, dan pelaksana proyek di berbagai wilayah Indonesia.
        </p>

        <div class="pt-1">
          <p class="mb-3 font-display text-sm font-bold uppercase tracking-wider text-safety">
            Kanal Resmi
          </p>
          <ul class="m-0 flex list-none flex-wrap items-center gap-2.5 p-0">
            {siteConfig.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.name} ${siteConfig.legalName}`}
                  class="inline-flex h-11 w-11 items-center justify-center rounded-[4px] border border-white/20 bg-steel-900 text-steel-muted transition-colors hover:border-safety hover:bg-safety hover:text-steel-950"
                >
                  <Icon name={socialIconMap[item.name]} size={18} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:gap-10">
        <div>
          <h2 class="mb-4 font-display text-lg font-bold uppercase tracking-wide text-white">
            Halaman
          </h2>
          <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
            {siteConfig.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-[38px] items-center text-sm text-steel-muted transition-colors hover:text-safety"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="mb-4 font-display text-lg font-bold uppercase tracking-wide text-white">
            Layanan
          </h2>
          <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
            {serviceLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-[38px] items-center text-sm text-steel-muted transition-colors hover:text-safety"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="rounded-[4px] border border-white/15 bg-steel-900/70 p-6">
        <h2 class="mb-4 font-display text-lg font-bold uppercase tracking-wide text-white">
          Kantor dan Workshop
        </h2>

        <ul class="m-0 flex list-none flex-col gap-3.5 p-0 text-sm text-steel-muted">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-safety" />
            <div>
              <p class="leading-relaxed text-white">{siteConfig.address.full}</p>
              <a
                href={siteConfig.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-safety hover:underline"
              >
                <span>Buka di Google Maps</span>
                <Icon name="external" size={13} />
              </a>
            </div>
          </li>

          <li class="flex items-center gap-3">
            <Icon name="whatsapp" size={18} class="shrink-0 text-safety" />
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[36px] items-center text-white transition-colors hover:text-safety"
            >
              {siteConfig.contact.whatsappDisplay}
            </a>
          </li>

          <li class="flex items-center gap-3">
            <Icon name="mail" size={18} class="shrink-0 text-safety" />
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="inline-flex min-h-[36px] items-center text-white transition-colors hover:text-safety"
            >
              {siteConfig.contact.email}
            </a>
          </li>

          <li class="flex items-start gap-3">
            <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-safety" />
            <span>{siteConfig.hours.label}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15 bg-steel-980">
    <div class="container-wide flex flex-col items-start justify-between gap-3 py-5 text-xs text-steel-muted sm:flex-row sm:items-center">
      <p>
        &copy; {currentYear} {siteConfig.legalName}. Seluruh hak cipta dilindungi.
      </p>
      <p>{siteConfig.tagline}</p>
    </div>
  </div>
</footer>