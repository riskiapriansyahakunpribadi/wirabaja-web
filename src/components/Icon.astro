---
import type { IconName } from '@/types/icon';
export type { IconName } from '@/types/icon';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'bucket' && (
    <g>
      <path d="M5 7h11l3 6-4 6H7L4 13l1-6Z" />
      <path d="M9 7V4h5v3" />
      <path d="M16 19l3 2" />
      <path d="M13 19l2 2.5" />
      <path d="M10 19l1 2.5" />
    </g>
  )}

  {name === 'track' && (
    <g>
      <rect x="2.5" y="7" width="19" height="10" rx="5" />
      <circle cx="7.5" cy="12" r="2" />
      <circle cx="12" cy="12" r="1.5" />
      <circle cx="16.5" cy="12" r="2" />
      <path d="M6 4h12" />
      <path d="M6 20h12" />
    </g>
  )}

  {name === 'boom' && (
    <g>
      <path d="M3 18h10v-4H6l-3 4Z" />
      <path d="M10 14l5-8 5 4-2 5" />
      <circle cx="15" cy="6" r="1.5" />
      <path d="M17 15l3 2-1.5 2.5-3-1.5" />
      <path d="M2 20h12" />
    </g>
  )}

  {name === 'gear' && (
    <g>
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
      <circle cx="12" cy="12" r="6.8" />
    </g>
  )}

  {name === 'helmet' && (
    <g>
      <path d="M4 15a8 8 0 0 1 16 0v2H4v-2Z" />
      <path d="M10 7.2V5h4v2.2" />
      <path d="M2.5 17h19" />
      <path d="M7 11.5h10" />
    </g>
  )}

  {name === 'wrench' && (
    <g>
      <path d="M14.7 6.3a4.5 4.5 0 0 0-6.1 6.1l-5 5a1.8 1.8 0 0 0 2.6 2.6l5-5a4.5 4.5 0 0 0 6.1-6.1l-2.6 2.6-2.6-2.6 2.6-2.6Z" />
    </g>
  )}

  {name === 'truck' && (
    <g>
      <path d="M2 15h14V7H2v8Z" />
      <path d="M16 10h4l2 3v2h-6v-5Z" />
      <circle cx="6.5" cy="17.5" r="2" />
      <circle cx="17.5" cy="17.5" r="2" />
    </g>
  )}

  {name === 'shield' && (
    <g>
      <path d="M12 3l7.5 3v6c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6L12 3Z" />
      <path d="M9 12l2 2 4-4" />
    </g>
  )}

  {name === 'layers' && (
    <g>
      <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3Z" />
      <path d="M3 12l9 4.5 9-4.5" />
      <path d="M3 16.5L12 21l9-4.5" />
    </g>
  )}

  {name === 'phone' && (
    <g>
      <path d="M6.5 3.5h3l1.5 4-2 1.8a11 11 0 0 0 5.7 5.7l1.8-2 4 1.5v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z" />
    </g>
  )}

  {name === 'mail' && (
    <g>
      <rect x="3" y="5" width="18" height="14" />
      <path d="M3 6.5l9 6.5 9-6.5" />
    </g>
  )}

  {name === 'map-pin' && (
    <g>
      <path d="M12 21s6.5-5.6 6.5-11a6.5 6.5 0 1 0-13 0c0 5.4 6.5 11 6.5 11Z" />
      <circle cx="12" cy="10" r="2.2" />
    </g>
  )}

  {name === 'clock' && (
    <g>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3.2 2" />
    </g>
  )}

  {name === 'whatsapp' && (
    <g>
      <path d="M12 3.5a8.5 8.5 0 0 0-7.4 12.6L3.5 20.5l4.6-1.1A8.5 8.5 0 1 0 12 3.5Z" />
      <path d="M9.4 9.2c-.3.6-.3 1.7.7 3s2.4 2.1 3.3 2.3c.7.2 1.3-.1 1.7-.5l.5-.7-1.6-.9-.6.5c-.4-.2-1.2-.8-1.8-1.5-.5-.6-.9-1.2-1-1.6l.5-.6-.9-1.6-.8.6Z" />
    </g>
  )}

  {name === 'arrow-right' && (
    <g>
      <path d="M4 12h15" />
      <path d="M13.5 6.5L19 12l-5.5 5.5" />
    </g>
  )}

  {name === 'chevron-down' && (
    <g>
      <path d="M6 9l6 6 6-6" />
    </g>
  )}

  {name === 'menu' && (
    <g>
      <path d="M3 6h18" />
      <path d="M3 12h18" />
      <path d="M3 18h12" />
    </g>
  )}

  {name === 'close' && (
    <g>
      <path d="M5 5l14 14" />
      <path d="M19 5L5 19" />
    </g>
  )}

  {name === 'check' && (
    <g>
      <path d="M4.5 12.5l5 5L19.5 7.5" />
    </g>
  )}

  {name === 'search' && (
    <g>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.5 15.5L20.5 20.5" />
    </g>
  )}

  {name === 'filter' && (
    <g>
      <path d="M3 5h18l-7 8v6l-4-2v-4L3 5Z" />
    </g>
  )}

  {name === 'linkedin' && (
    <g>
      <rect x="3.5" y="3.5" width="17" height="17" />
      <path d="M8 10.5V16" />
      <circle cx="8" cy="7.5" r="0.7" fill="currentColor" />
      <path d="M11.5 16v-5.5" />
      <path d="M11.5 12.5a2.3 2.3 0 0 1 4.5 0V16" />
    </g>
  )}

  {name === 'instagram' && (
    <g>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3.5" />
      <circle cx="12" cy="12" r="3.8" />
      <circle cx="16.8" cy="7.2" r="0.8" fill="currentColor" />
    </g>
  )}

  {name === 'youtube' && (
    <g>
      <rect x="2.5" y="5.5" width="19" height="13" rx="2.5" />
      <path d="M10 9.5l5 2.5-5 2.5v-5Z" fill="currentColor" />
    </g>
  )}

  {name === 'external' && (
    <g>
      <path d="M14 4h6v6" />
      <path d="M20 4l-9 9" />
      <path d="M18 13v6H5V6h6" />
    </g>
  )}
</svg>