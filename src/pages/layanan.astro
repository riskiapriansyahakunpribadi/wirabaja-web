---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import { buyVsRentComparison, services } from '@/data/services';
import { siteConfig } from '@/config/site';
---

<Base
  title="Layanan Alat Berat"
  description="Layanan penjualan unit baru dan bekas, penyewaan proyek, servis berkala, pasokan suku cadang, dan pendampingan pembiayaan alat berat dari PT Wirabaja Mesin Nusantara."
>
  <!-- Kepala halaman Layanan -->
  <section class="relative overflow-hidden bg-steel-950 py-14 text-white lg:py-18">
    <div
      class="pointer-events-none absolute top-0 right-0 hidden h-full w-[28%] bg-safety/12 lg:block"
      style="clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);"
      aria-hidden="true"
    ></div>

    <div class="container-wide relative z-10">
      <nav aria-label="Jejak halaman" class="mb-4 text-xs font-semibold uppercase tracking-wider text-steel-muted">
        <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
          <li><a href="/" class="text-steel-muted hover:text-safety">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-safety">Layanan</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <p class="section-kicker section-kicker-dark">Layanan Terpadu</p>
        <h1 class="text-white">
          Pengadaan, Penyewaan, Servis, dan Suku Cadang dalam Satu Pintu
        </h1>
        <p class="mt-4 text-base leading-relaxed text-steel-muted">
          Setiap layanan disertai syarat kerja dan alur pengerjaan yang terbuka sejak awal, sehingga tim pengadaan dan manajer proyek dapat menyusun jadwal lapangan secara pasti.
        </p>
      </div>

      <!-- Bar lompat cepat antar layanan -->
      <nav
        aria-label="Navigasi bagian layanan"
        class="mt-8 flex flex-wrap gap-2 border-t border-white/15 pt-6"
      >
        {services.map((service) => (
          <a
            href={`#${service.id}`}
            class="inline-flex min-h-[44px] items-center gap-2 rounded-[4px] border border-white/20 bg-steel-900/80 px-4 font-display text-sm font-bold uppercase tracking-wide text-white transition-colors hover:border-safety hover:bg-safety hover:text-steel-950"
          >
            <span class="text-safety group-hover:text-steel-950">{service.number}</span>
            <span>{service.shortTitle}</span>
          </a>
        ))}
        <a
          href="#perbandingan-beli-sewa"
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[4px] border border-safety bg-safety/15 px-4 font-display text-sm font-bold uppercase tracking-wide text-safety transition-colors hover:bg-safety hover:text-steel-950"
        >
          <span>Perbandingan Beli vs Sewa</span>
        </a>
      </nav>
    </div>
  </section>

  <!-- Lima bagian layanan bergantian warna latar -->
  {services.map((service, index) => {
    const isEven = index % 2 === 1;
    const sectionBg = isEven ? 'bg-surface-white' : 'bg-surface-warm';
    const boxBg = isEven ? 'bg-surface-warm' : 'bg-surface-white';

    return (
      <section
        id={service.id}
        aria-labelledby={`heading-${service.id}`}
        class={`section-pad scroll-mt-28 border-b border-border-light ${sectionBg}`}
      >
        <div class="container-wide">
          <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
            <!-- Kolom narasi dan Foto -->
            <div class:list={['space-y-6 lg:col-span-5', isEven ? 'lg:order-2' : 'lg:order-1']}>
              <div class="flex items-center gap-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[2px] bg-steel-950 font-display text-xl font-extrabold text-safety">
                  {service.number}
                </span>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[2px] border border-border-light bg-surface-white text-steel-950">
                  <Icon name={service.icon} size={22} />
                </span>
              </div>

              <div>
                <h2 id={`heading-${service.id}`} class="text-steel-950">
                  {service.title}
                </h2>
                <p class="mt-3 text-base font-medium leading-relaxed text-steel-950">
                  {service.summary}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-steel-gray">
                  {service.details}
                </p>
              </div>

              <div class="cut-corner-tr overflow-hidden border-l-4 border-safety bg-steel-950">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover"
                />
              </div>

              <div class="flex flex-wrap gap-3 pt-1">
                <Button
                  href={service.ctaHref}
                  variant="primary"
                  icon="arrow-right"
                >
                  {service.ctaLabel}
                </Button>
                <Button
                  href="/produk"
                  variant="outline-dark"
                  icon="bucket"
                  iconPosition="left"
                >
                  Lihat Unit Tersedia
                </Button>
              </div>
            </div>

            <!-- Kolom rincian ruang lingkup, syarat, dan alur kerja -->
            <div class:list={['space-y-6 lg:col-span-7', isEven ? 'lg:order-1' : 'lg:order-2']}>
              <div class="grid gap-6 md:grid-cols-2">
                <Reveal class={`rounded-[4px] border border-border-light p-6 ${boxBg}`}>
                  <h3 class="text-2xl text-steel-950">Cakupan Layanan</h3>
                  <ul class="m-0 mt-4 list-none space-y-2.5 p-0 text-sm leading-relaxed text-steel-gray">
                    {service.scope.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <Icon name="check" size={16} class="mt-1 shrink-0 text-safety-dark" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </Reveal>

                <Reveal delay={70} class={`rounded-[4px] border border-border-light p-6 ${boxBg}`}>
                  <h3 class="text-2xl text-steel-950">Syarat Pengajuan</h3>
                  <ul class="m-0 mt-4 list-none space-y-2.5 p-0 text-sm leading-relaxed text-steel-gray">
                    {service.requirements.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <Icon name="shield" size={16} class="mt-1 shrink-0 text-steel-950" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </Reveal>
              </div>

              <Reveal delay={120} class="rounded-[4px] border border-border-light border-t-4 border-t-steel-950 bg-surface-white p-6">
                <h3 class="text-2xl text-steel-950">Alur Pengerjaan</h3>
                <ol class="m-0 mt-5 grid list-none gap-4 p-0 sm:grid-cols-2">
                  {service.steps.map((step, stepIdx) => (
                    <li class="flex items-start gap-3 rounded-[4px] bg-surface-warm p-4">
                      <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[2px] bg-steel-950 font-display text-sm font-bold text-safety">
                        0{stepIdx + 1}
                      </span>
                      <p class="text-sm leading-relaxed text-steel-gray">{step}</p>
                    </li>
                  ))}
                </ol>
              </Reveal>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- Tabel perbandingan jujur: Beli vs Sewa -->
  <section
    id="perbandingan-beli-sewa"
    aria-labelledby="perbandingan-heading"
    class="section-pad scroll-mt-28 bg-steel-950 text-white"
  >
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="section-kicker section-kicker-dark">Pertimbangan Pengadaan</p>
        <h2 id="perbandingan-heading" class="text-white">
          Perbandingan Jujur: Kapan Lebih Tepat Beli dan Kapan Lebih Tepat Sewa
        </h2>
        <p class="mt-3 text-base leading-relaxed text-steel-muted">
          Tidak setiap proyek membutuhkan pembelian unit baru. Gunakan perbandingan berikut untuk mencocokkan keputusan pengadaan dengan durasi kontrak kerja, ketersediaan mekanik internal, dan arus kas perusahaan Anda.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto rounded-[4px] border border-white/15 bg-steel-900">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b-2 border-safety bg-steel-980 text-white">
              <th scope="col" class="w-[22%] px-5 py-4 font-display text-base font-bold uppercase tracking-wide text-safety">
                Aspek Pertimbangan
              </th>
              <th scope="col" class="w-[39%] px-5 py-4 font-display text-base font-bold uppercase tracking-wide text-white">
                Beli Unit (Baru atau Bekas)
              </th>
              <th scope="col" class="w-[39%] px-5 py-4 font-display text-base font-bold uppercase tracking-wide text-white">
                Sewa Unit Proyek
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/15">
            {buyVsRentComparison.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-steel-900' : 'bg-steel-950/60'}>
                <th scope="row" class="px-5 py-4 align-top font-semibold text-white">
                  {row.aspect}
                </th>
                <td class="px-5 py-4 align-top leading-relaxed text-steel-muted">
                  {row.buy}
                </td>
                <td class="px-5 py-4 align-top leading-relaxed text-steel-muted">
                  {row.rent}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <div class="rounded-[4px] border border-white/15 border-l-4 border-l-safety bg-steel-900/90 p-6">
          <h3 class="text-2xl text-white">Kapan Pembelian Lebih Masuk Akal</h3>
          <p class="mt-2 text-sm leading-relaxed text-steel-muted">
            Pilih membeli jika perusahaan memiliki jadwal proyek berkesinambungan sepanjang tahun, ingin mengendalikan jadwal alat penuh tanpa antre sewa, serta siap mengelola operator dan penyimpanan unit sendiri.
          </p>
        </div>

        <div class="rounded-[4px] border border-white/15 border-l-4 border-l-safety bg-steel-900/90 p-6">
          <h3 class="text-2xl text-white">Kapan Penyewaan Lebih Masuk Akal</h3>
          <p class="mt-2 text-sm leading-relaxed text-steel-muted">
            Pilih menyewa jika proyek berdurasi beberapa minggu hingga beberapa bulan, membutuhkan jenis alat khusus yang jarang dipakai ulang, atau ingin menjaga modal kerja tetap fokus pada material dan tenaga kerja.
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-white/15 pt-6">
        <p class="text-sm text-steel-muted">
          Masih menimbang opsi untuk proyek Anda? Tim penjualan kami di {siteConfig.address.short} siap menghitungkan perkiraan biaya keduanya secara tertulis.
        </p>
        <Button href="/kontak" variant="primary" icon="arrow-right">
          Diskusikan Opsi Beli atau Sewa
        </Button>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Butuh Penawaran Resmi Layanan Alat Berat?"
    description="Sampaikan kebutuhan pembelian, sewa, perawatan berkala, atau daftar kode suku cadang Anda agar kami segera menyiapkan penawaran tertulis."
  />
</Base>