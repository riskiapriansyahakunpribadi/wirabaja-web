---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import Icon from '@/components/Icon.astro';
import { projects, projectSectors } from '@/data/projects';

const totalProjects = projects.length;
const totalSectors = projectSectors.length;
---

<Base
  title="Proyek dan Sektor Kerja"
  description="Galeri penerapan unit alat berat PT Wirabaja Mesin Nusantara pada sektor pertambangan, infrastruktur, perkebunan, konstruksi, kehutanan, dan pergudangan."
>
  <!-- Kepala halaman Proyek -->
  <section class="relative overflow-hidden bg-steel-950 py-14 text-white lg:py-18">
    <div
      class="pointer-events-none absolute top-0 right-0 hidden h-full w-[28%] bg-safety/12 lg:block"
      style="clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);"
      aria-hidden="true"
    ></div>

    <div class="container-wide relative z-10">
      <nav aria-label="Jejak halaman" class="mb-4 text-xs font-semibold uppercase tracking-wider text-steel-muted">
        <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
          <li><a href="/" class="text-steel-muted hover:text-safety">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-safety">Proyek</li>
        </ol>
      </nav>

      <div class="grid items-end gap-8 lg:grid-cols-[1.3fr_auto]">
        <div class="max-w-2xl">
          <p class="section-kicker section-kicker-dark">Penerapan Lapangan</p>
          <h1 class="text-white">
            Pasokan Unit Lintas Sektor di Berbagai Wilayah Indonesia
          </h1>
          <p class="mt-4 text-base leading-relaxed text-steel-muted">
            Saring pekerjaan berdasarkan sektor industri lalu buka panel rincian pada setiap proyek untuk melihat kebutuhan lapangan, unit yang dipasok, dan hasil pengoperasiannya.
          </p>
        </div>

        <dl class="m-0 grid grid-cols-2 gap-5 border border-white/15 bg-steel-900/80 px-5 py-4">
          <div>
            <dt class="text-xs uppercase tracking-wide text-steel-muted">Sektor Industri</dt>
            <dd class="m-0 mt-1 font-display text-2xl font-extrabold text-safety">{totalSectors}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-steel-muted">Ringkasan Proyek</dt>
            <dd class="m-0 mt-1 font-display text-2xl font-extrabold text-white">{totalProjects}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Galeri proyek dan filter sektor -->
  <section
    aria-label="Galeri proyek alat berat"
    data-projects-root
    class="section-pad bg-surface-warm"
  >
    <div class="container-wide">
      <!-- Bar filter sektor -->
      <div class="rounded-[4px] border border-border-light bg-surface-white p-5 shadow-sm sm:p-6">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Saring proyek berdasarkan sektor">
          <span class="mr-2 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-steel-gray">
            <Icon name="filter" size={14} />
            <span>Sektor:</span>
          </span>

          <button
            type="button"
            data-project-filter="semua"
            data-active="true"
            aria-pressed="true"
            class="project-filter-btn"
          >
            Semua Sektor ({totalProjects})
          </button>

          {projectSectors.map((sector) => {
            const count = projects.filter((item) => item.sector === sector.slug).length;
            return (
              <button
                type="button"
                data-project-filter={sector.slug}
                data-active="false"
                aria-pressed="false"
                class="project-filter-btn"
              >
                {sector.name} ({count})
              </button>
            );
          })}
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        <p data-projects-count aria-live="polite" class="text-sm font-semibold text-steel-950">
          Menampilkan {totalProjects} dari {totalProjects} ringkasan proyek
        </p>
        <p class="text-xs text-steel-gray">
          Identitas pemilik proyek dijaga kerahasiaannya sesuai etika kerja sama bisnis.
        </p>
      </div>

      <!-- Daftar kartu proyek dengan panel rincian buka-tutup -->
      <div class="mt-6 grid gap-8 lg:grid-cols-2">
        {projects.map((project) => (
          <article
            id={project.id}
            data-project-card
            data-project-sector={project.sector}
            class="project-card scroll-mt-28 flex flex-col overflow-hidden rounded-[4px] border border-border-light bg-surface-white shadow-sm transition-all duration-300 hover:border-steel-950 hover:shadow-md"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-steel-950">
              <img
                src={project.image}
                alt={project.imageAlt}
                width="800"
                height="540"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 bg-safety px-3 py-1 font-display text-xs font-bold uppercase tracking-wider text-steel-950">
                {project.sectorLabel}
              </span>
              <span class="absolute right-3 bottom-3 bg-steel-950/90 px-3 py-1 text-xs font-semibold text-white">
                {project.serviceMode}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-steel-gray">
                <Icon name="map-pin" size={14} class="text-safety-dark" />
                <span>{project.location}</span>
              </div>

              <h2 class="mt-2 text-2xl text-steel-950 sm:text-3xl">
                {project.title}
              </h2>

              <p class="mt-3 text-sm leading-relaxed text-steel-gray">
                {project.summary}
              </p>

              <!-- Panel buka-tutup aksesibel untuk kebutuhan, unit dipasok, dan hasil -->
              <details class="project-details mt-5 rounded-[4px] border border-border-light bg-surface-warm">
                <summary class="flex min-h-[48px] list-none items-center justify-between gap-3 px-4 py-3 font-display text-base font-bold uppercase tracking-wide text-steel-950 transition-colors hover:bg-surface-tint">
                  <span>Buka Rincian Kebutuhan, Unit, dan Hasil</span>
                  <span class="details-chevron inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-[2px] bg-steel-950 text-safety transition-transform duration-200">
                    <Icon name="chevron-down" size={16} />
                  </span>
                </summary>

                <div class="space-y-4 border-t border-border-light bg-surface-white p-5 text-sm leading-relaxed">
                  <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-wide text-steel-950">
                      Kebutuhan Klien
                    </h3>
                    <p class="mt-1.5 text-steel-gray">{project.clientNeed}</p>
                  </div>

                  <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-wide text-steel-950">
                      Unit yang Dipasok
                    </h3>
                    <ul class="m-0 mt-2 list-none space-y-2 p-0 text-steel-gray">
                      {project.unitsSupplied.map((unit) => (
                        <li class="flex items-start gap-2">
                          <Icon name="check" size={15} class="mt-1 shrink-0 text-safety-dark" />
                          <span>{unit}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h3 class="font-display text-lg font-bold uppercase tracking-wide text-steel-950">
                      Hasil Pelaksanaan
                    </h3>
                    <p class="mt-1.5 text-steel-gray">{project.outcome}</p>
                  </div>

                  <div class="border-t border-border-light pt-4">
                    <p class="text-xs font-bold uppercase tracking-wider text-steel-gray">
                      Lihat Spesifikasi Unit Terkait:
                    </p>
                    <div class="mt-2.5 flex flex-wrap gap-2">
                      {project.relatedProducts.map((rel) => (
                        <a
                          href={rel.href}
                          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-[4px] border border-steel-950/25 bg-surface-warm px-3 py-1.5 font-display text-xs font-bold uppercase tracking-wide text-steel-950 transition-colors hover:border-steel-950 hover:bg-safety"
                        >
                          <span>{rel.label}</span>
                          <Icon name="arrow-right" size={13} />
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </details>

              <div class="mt-5 pt-1">
                <Button
                  href="/kontak"
                  variant="outline-dark"
                  size="sm"
                  icon="arrow-right"
                  class="w-full justify-between sm:w-auto"
                >
                  Konsultasi Proyek Serupa
                </Button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Keadaan kosong jika filter tidak menemukan hasil -->
      <div
        data-projects-empty
        hidden
        class="mt-8 rounded-[4px] border-2 border-dashed border-border-input bg-surface-white px-6 py-12 text-center"
      >
        <h2 class="text-3xl text-steel-950">Proyek pada Sektor Ini Belum Tersedia</h2>
        <p class="mx-auto mt-2 max-w-lg text-sm text-steel-gray">
          Pilih tombol di bawah untuk menampilkan kembali seluruh ringkasan proyek lintas sektor.
        </p>
        <div class="mt-5">
          <button type="button" data-projects-reset class="btn btn-primary btn-sm">
            Tampilkan Semua Proyek
          </button>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Sedang Merencanakan Pengadaan Alat untuk Proyek Baru?"
    description="Diskusikan karakter medan, volume pekerjaan, dan target waktu mulai Anda. Tim kami membantu menyusun kombinasi unit yang pas."
  />

  <script>
    import '@/scripts/project-filter';
  </script>
</Base>

<style>
  .project-filter-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-border-light);
    background-color: var(--color-surface-warm);
    color: var(--color-steel-950);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) var(--ease-industrial),
      border-color var(--duration-fast) var(--ease-industrial),
      color var(--duration-fast) var(--ease-industrial);
  }

  .project-filter-btn:hover {
    border-color: var(--color-steel-950);
    background-color: var(--color-surface-tint);
  }

  .project-filter-btn[data-active='true'] {
    border-color: var(--color-steel-950);
    background-color: var(--color-steel-950);
    color: var(--color-surface-white);
    box-shadow: inset 0 -3px 0 var(--color-safety);
  }

  .project-details summary::-webkit-details-marker {
    display: none;
  }

  .project-details[open] .details-chevron {
    transform: rotate(180deg);
  }

  .project-card:hover img {
    transform: scale(1.04);
  }
</style>